{
	"schemaVersion": 1,
	"id": "aero",
	"version": "${version}",
	"name": "Aero",
	"description": "A personal-use Minecraft utility client: modules for movement, rendering, and visibility, with a config-driven ClickGUI.",
	"authors": [
		"Finn"
	],
	"contact": {
		"homepage": "https://fabricmc.net/"
	},
	"license": "CC0-1.0",
	"environment": "client",
	"mixins": [
		"aero.mixins.json"
	],
	"entrypoints": {
		"client": [
			{
				"adapter": "kotlin",
				"value": "dev.finn.aero.client.AeroClient"
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}
